# ─────────────────────────────────────────────────────────────────────────────
# Fireblocks NCW demo backend + migration audit endpoints — env
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).
# Secrets belong in a secrets manager in any non-local environment.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# API listen port.
PORT=3000

# DEMO ONLY — set to "true" to skip Fireblocks webhook signature verification.
# Leave UNSET (or "false") in any real environment; it disables a security control.
WEBHOOK_SKIP_VERIFY=false

# (optional) Comma-separated CORS allow-list. Defaults to
# http://localhost:5173,https://fireblocks.github.io when unset.
# ORIGIN_WEB_SDK=http://localhost:5173

# ─── CoinMarketCap (USD quotes; optional feature) ───
CMC_PRO_API_KEY=your-coinmarketcap-api-key

# ─── Auth: JWT verification (OpenID Connect) ───
# Provide EITHER ISSUER_BASE_URL (issuer discovery), OR ISSUER + JWKS_URI.
# AUDIENCE must match the `aud` claim of the tokens the frontend sends.
# ISSUER_BASE_URL=https://your-issuer-domain
JWKS_URI=https://your-issuer-domain/.well-known/jwks.json
ISSUER=https://your-issuer-domain
AUDIENCE=https://your-api-audience

# ─── Fireblocks API ───
# PEM values must be a single line with each newline replaced by the literal
# two characters backslash-n. Use a DEDICATED API user key; never reuse a
# production signing key for a demo.
FIREBLOCKS_API_SECRET=your_api_user_private_key_pem_single_line_escaped_newlines
FIREBLOCKS_API_KEY_NCW_SIGNER=00000000-0000-0000-0000-000000000000
FIREBLOCKS_API_KEY_NCW_ADMIN=00000000-0000-0000-0000-000000000000
# Sandbox: https://sandbox-api.fireblocks.io/  ·  Production: https://api.fireblocks.io/
FIREBLOCKS_API_BASE_URL=https://sandbox-api.fireblocks.io/

# Fireblocks webhook public key PEM (sandbox and production differ), same
# single-line escaped format as above.
FIREBLOCKS_WEBHOOK_PUBLIC_KEY=your_fireblocks_webhook_public_key_pem_single_line_escaped_newlines

# ─── Database (MySQL) ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=ncw
DB_PASSWORD=change-me
DB_NAME=ncw_demo
